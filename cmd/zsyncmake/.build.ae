//
// aeb build for `zsyncmake` (.zsync control-file generator). Links the
// rcksum/fileio.c positional-I/O shim (zsyncmake imports rcksum.fileio).
import build
import aether
import aether (source, output, extra_source)
main() {
    b = build.start()
    aether.program(b) {
        source("../zsyncmake.ae")
        extra_source("../../rcksum/fileio.c")
        output("zsyncmake")
    }
}
