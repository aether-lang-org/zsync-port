//
// aeb build for the native `fileserver` (Range-honouring static server,
// the zsync download endpoint). Pure Aether (std.http) — no C shim.
import build
import aether
import aether (source, output)
main() {
    b = build.start()
    aether.program(b) {
        source("../fileserver.ae")
        output("fileserver")
    }
}
